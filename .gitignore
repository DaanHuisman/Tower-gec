__pycache__/
*.pyc
logs/

# Generated evaluation inputs (rebuilt by setup/4_build_data.sh). gec_eval.jsonl contains MultiGEC text,
# which must not be redistributed.
eval/data/

# Model outputs contain the test sources/references (incl. MultiGEC). Only commit score summaries:
#   results/<run>.summary.txt, results/<run>.gec_summary.txt, results/<run>.gec_scores.json,
#   results/<run>.tasks_summary.txt, results/<run>.tasks_scores.json,
#   results/<run>.gec_paper_summary.txt, results/<run>.gec_paper_scores.json,
#   results/SIGNIFICANCE.md, results/significance.json
results/*.jsonl
results/gec_work/
